{
  "name": "dsh-hello-plugin",
  "version": "0.1.1",
  "description": "A minimal DeepSeek Harness (dsh) plugin: registers one host tool `hello_plugin`. Serves as a copyable starting point for writing your own DSH plugin.",
  "license": "MIT",
  "author": "mrkeyoe",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "template"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2 || >=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}